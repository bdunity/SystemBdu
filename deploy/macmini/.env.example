# Copiar a .env en la Mac mini y llenar. Nunca subir .env a git.

# Direccion publica (con https://). Fase 1: https://exclusion-refrain-bring.ngrok-free.dev
# Fase 2: https://system.bdunity.com
BASEROW_PUBLIC_URL=https://system.bdunity.com

# Authtoken del agente (dashboard de ngrok > Getting Started > Your Authtoken).
NGROK_AUTHTOKEN=

# Dejar vacio salvo que n8n reciba webhooks en una IP privada.
BASEROW_WEBHOOKS_ALLOW_PRIVATE_ADDRESS=

# Cuantos respaldos conservar en backups/ (los mas viejos se borran).
BACKUP_KEEP=14
