# Copiar a .env (ignorado por git) y llenar. Nunca poner valores reales en este archivo.
# Contrasenas y claves: solo letras y numeros, porque van dentro de URLs de conexion.

# --- Baserow ---
# 8081 para no chocar con otro contenedor que ya use 8080. El puerto de la URL debe coincidir.
BASEROW_PORT=8081
BASEROW_PUBLIC_URL=http://localhost:8081
# Dejar vacio salvo que n8n este en una IP privada (riesgo de seguridad, ver README).
BASEROW_WEBHOOKS_ALLOW_PRIVATE_ADDRESS=

# --- Teable ---
TEABLE_PORT=3000
TEABLE_PUBLIC_ORIGIN=http://127.0.0.1:3000
TEABLE_POSTGRES_PASSWORD=
TEABLE_REDIS_PASSWORD=
TEABLE_SECRET_KEY=

# --- Monday (tarea 2, solo lectura) ---
MONDAY_API_TOKEN=

# --- Cuentas de la PoC para los imports (tarea 3). Solo para esta PoC, nunca credenciales reales.
BASEROW_EMAIL=
BASEROW_PASSWORD=
TEABLE_EMAIL=
TEABLE_PASSWORD=

# --- Cuenta de Baserow en la Mac mini (para scripts\migrate_area.py --mac).
MAC_BASEROW_EMAIL=
MAC_BASEROW_PASSWORD=
